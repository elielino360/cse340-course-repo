<%- include('partials/header') %>

<main>

    <h1><%= title %></h1>

    <h2>Upcoming Service Projects</h2>

    <ul>

        <% upcomingProjects.forEach(project => { %>

            <li>

                <%= project.date.toLocaleDateString() %>:

                <a href="/projects/<%= project.project_id %>">
                    <%= project.title %>
                </a>

                <a href="/organizations/<%= project.organization_id %>">
                    (<%= project.name %>)
                </a>

            </li>

        <% }) %>

    </ul>
    <p><a href="/new-project">Add a New Service Project</a></p>
    

</main>

<%- include('partials/footer') %>