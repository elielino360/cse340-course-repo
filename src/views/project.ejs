<%- include('partials/header') %>

<p>
    
    <main>
        Partner Organization:
    <a href="/organizations/<%= project.organization_id %>">
        <%= project.name %>
    </a>
    <p>
    <a href="/assign-categories/<%= project.project_id %>">
        Edit Categories
    </a>
</p>
<p>
    <a href="/edit-project/<%= project.project_id %>">
        Edit Project
    </a>
</p>
<% if (user) { %>

    <form action="/volunteer/<%= project.project_id %>" method="POST">
        <button type="submit">
            Volunteer for this project
        </button>
    </form>

    <form action="/unvolunteer/<%= project.project_id %>" method="POST">
                    <button type="submit">Unvolunteer for this project</button>
    </form>

<% } else { %>

    <p>You must logged in to volunteer.</p>

<% } %>
    </main>
    
</p>
<%- include('partials/footer') %>