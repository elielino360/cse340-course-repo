<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <ul>
        <% categories.forEach(category => { %>

            <li>
                <a href="/categories/<%= category.category_id %>">
                    <%= category.cat_name %>
                </a>
            </li>

        <% }) %>
    </ul>
    <p>

        <% if (user && user.role_name === 'admin') { %>
    <a href="/new-category">Add New Category</a>
<% } %>
    </p>

</main>

<%- include('partials/footer') %>