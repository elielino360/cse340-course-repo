<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <ul>
        <% categories.forEach(category => { %>

            <li>
                <a href="/categories/<%= category.category_id %>">
                    <%= category.cat_name %>
                </a>
            </li>

        <% }) %>
    </ul>
    <p>
        <button><a href="/new-category"> Add New Category </a> </button>
    </p>

</main>

<%- include('partials/footer') %>